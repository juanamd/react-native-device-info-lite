{
  "name": "react-native-device-info-lite",
  "version": "2.0.0",
  "description": "Get basic device information using react-native (Android, New Architecture)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "android",
    "!android/build",
    "!android/.gradle"
  ],
  "scripts": {
    "typecheck": "tsc"
  },
  "keywords": [
    "react-native",
    "android",
    "device",
    "turbomodule",
    "new-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/juanamd/react-native-device-info-lite"
  },
  "author": "Juan Story",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "typescript": "^5.8.3"
  },
  "codegenConfig": {
    "name": "DeviceInfoLiteSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "os.juanamd.deviceinfolite"
    }
  }
}
